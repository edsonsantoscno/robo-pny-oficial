# ==============================================================================
# 🚀 MODELO DE CONFIGURAÇÃO GLOBAL - COPYTRADER PNY (PRODUÇÃO)
# ==============================================================================
# Renomeie este arquivo para .env na sua VPS Hostinger e preencha com seus dados reais.
# ATENÇÃO: Nunca adicione o arquivo .env real ao Git!

# 🌐 CONEXÃO CENTRAL DO BANCO DE DADOS E SAAS
SUPABASE_URL=https://mandacarurn.com.br
SUPABASE_KEY=COLE_AQUI_A_SUA_ANON_KEY_OU_SERVICE_ROLE_DO_SUPABASE

# 🤖 CONFIGURAÇÕES DA CONTA MESTRE (ROBO_TRADER)
KEY_BINANCE=COLE_AQUI_A_API_KEY_DA_CONTA_MESTRE
SECRET_BINANCE=COLE_AQUI_A_SECRET_KEY_DA_CONTA_MESTRE

# 🖥️ TELEMETRIA E REDE INTERNA DO DOCKER CLUSTER
WS_HOST=websocket-server
WS_PORT=6001
LOG_FILE=/app/trading_logs_trader.txt
RECV_WINDOW=10000

# 🔐 CHAVE DE SESSÃO DO DASHBOARD FLASK (GERAR UMA STRING ALEATÓRIA)
SECRET_KEY=QUALQUER_TEXTO_LONGO_E_SEGURO_PARA_PROTEGER_O_LOGIN
