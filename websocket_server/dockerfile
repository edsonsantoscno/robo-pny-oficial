FROM python:3.12-slim

WORKDIR /app

# Instala dependências do sistema (timezone, build-essential, curl)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Configura o fuso horário para bater com o horário brasileiro
ENV TZ=America/Sao_Paulo
RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copia requirements e instala dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo o código do websocket_server para /app
COPY . .

# Expõe a porta de comunicação do WebSocket mapeada na Parte 1
EXPOSE 6001

# Arquivo principal do websocket server operando em loop assíncrono nativo
CMD ["python", "websocket_server.py"]
