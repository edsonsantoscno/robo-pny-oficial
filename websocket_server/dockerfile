FROM python:3.12-slim

WORKDIR /app

# Instala dependências do sistema e remove cache para manter a imagem leve
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Configura o fuso horário oficial brasileiro
ENV TZ=America/Sao_Paulo
RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
# Copia e instala primeiro os pacotes do Python para aproveitar o cache do Docker
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CORREÇÃO CRÍTICA: Copia o conteúdo atual de forma isolada sem vazar arquivos externos
COPY . .
# Expõe a porta de comunicação assíncrona do WebSocket mapeada no config
EXPOSE 6001

# Comando de inicialização contínua do servidor 24/7
CMD ["python", "websocket_server.py"]
